# Base de données (voir docker-compose.yml)
DATABASE_URL="postgresql://urbanflow:CHANGE_ME@localhost:5433/urbanflow"
POSTGRES_DB="urbanflow"
POSTGRES_USER="urbanflow"
POSTGRES_PASSWORD="CHANGE_ME"

# Serveur
API_PORT="3001"
WEB_ORIGIN="http://localhost:3000"

# Authentification
JWT_SECRET="CHANGE_ME"
GOOGLE_CLIENT_ID="CHANGE_ME"
GOOGLE_CLIENT_SECRET="CHANGE_ME"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# Services externes
ORS_API_KEY="CHANGE_ME"

# PRIM, Île-de-France Mobilités (https://prim.iledefrance-mobilites.fr)
PRIM_API_KEY="CHANGE_ME"
PRIM_NAVITIA_DAILY_LIMIT=1000
PRIM_STOP_MONITORING_DAILY_LIMIT=1000
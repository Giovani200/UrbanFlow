// Prisma 6, UrbanFlow Mobility

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── MODULE USERS ───────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  googleId        String?   @unique
  acceptedTermsAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  preferences   Preferences?
  trips           Trip[]
  carbonEntries   CarbonEntry[]

  @@map("users")
}

model Preferences {
  id     String @id @default(cuid())
  userId String @unique

  weightCarbon     Int      @default(50)
  weightTime       Int      @default(30)
  weightCost       Int      @default(20)
  wheelchairAccess Boolean  @default(false)
  avoidStairs      Boolean  @default(false)
  preferredModes   String[]
  monthlyGoalKg    Int?

  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("preferences")
}

// ─── MODULE TRIPS ───────────────────────────────────────────

model Trip {
  id     String  @id @default(cuid())
  userId String?

  originLat   Float
  originLng   Float
  originLabel String
  destLat     Float
  destLng     Float
  destLabel   String

  durationSeconds Int
  distanceMeters  Int
  carbonGrams     Float
  score           Float

  modes     String[]
  steps     Json
  status    TripStatus @default(PLANNED)
  createdAt DateTime   @default(now())

  user          User?         @relation(fields: [userId], references: [id])
  carbonEntries CarbonEntry[]

  @@map("trips")
}

enum TripStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

// ─── MODULE TRANSPORT ───────────────────────────────────────

model TransportStop {
  id         String  @id
  name       String
  lat        Float
  lng        Float
  wheelchair Boolean @default(false)

  stopRoutes StopRoute[]

  @@map("transport_stops")
}

model TransportRoute {
  id        String  @id
  shortName String
  longName  String
  type      Int
  color     String?

  stopRoutes StopRoute[]

  @@map("transport_routes")
}

model StopRoute {
  stopId   String
  routeId  String
  sequence Int

  stop  TransportStop  @relation(fields: [stopId], references: [id])
  route TransportRoute @relation(fields: [routeId], references: [id])

  @@id([stopId, routeId, sequence])
  @@map("stop_routes")
}

// ─── MODULE CARBON ──────────────────────────────────────────

model CarbonEntry {
  id     String  @id @default(cuid())
  userId String
  tripId String?

  mode        String
  distanceKm  Float
  carbonGrams Float
  savedVsCar  Float

  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id])
  trip Trip? @relation(fields: [tripId], references: [id])

  @@map("carbon_entries")
}
